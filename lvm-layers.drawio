<mxfile host="app.diagrams.net" modified="2026-06-05" version="21.0.0">
  <diagram id="lvm-stack" name="LVM Layer Stack">
    <mxGraphModel dx="1422" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="0" page="1" pageScale="1" pageWidth="1400" pageHeight="970" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="10"
          value="LVM Layer Stack — Ubuntu Kiosk on Surface Pro 3"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="10" width="1300" height="45" as="geometry" />
        </mxCell>

        <!-- LAYER 1: PHYSICAL DISK -->
        <mxCell id="20"
          value="&lt;b style='font-size:14px'&gt;Physical SSD&lt;/b&gt;&lt;br&gt;&lt;i&gt;/dev/sda — 238.5 GB&lt;/i&gt;&lt;br&gt;&lt;font color='#444444'&gt;The actual hardware inside the Surface Pro 3. A chip on the motherboard. Everything else is abstraction sitting on top of this.&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontColor=#333333;fontSize=12;verticalAlign=middle;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="1300" height="90" as="geometry" />
        </mxCell>

        <!-- Arrow 1 -->
        <mxCell id="21" value=""
          style="endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="160" as="sourcePoint" />
            <mxPoint x="700" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- LAYER 2: PARTITION -->
        <mxCell id="30"
          value="&lt;b style='font-size:14px'&gt;Partition — sda3&lt;/b&gt;&lt;br&gt;&lt;i&gt;41.7 GB &lt;font color='#cc0000'&gt;(resized from 116 GB using parted)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color='#444444'&gt;A defined slice of the disk. GPT partition table divides the disk: sda1 = EFI 1G, sda2 = /boot 2G, sda3 = LVM 41.7G.&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="125" y="190" width="1150" height="90" as="geometry" />
        </mxCell>

        <!-- Arrow 2 -->
        <mxCell id="31" value=""
          style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="280" as="sourcePoint" />
            <mxPoint x="700" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- LAYER 3: PHYSICAL VOLUME -->
        <mxCell id="40"
          value="&lt;b style='font-size:14px'&gt;Physical Volume (PV)&lt;/b&gt;&lt;br&gt;&lt;i&gt;/dev/sda3 — 41.65 GB &lt;font color='#cc0000'&gt;(reconciled with pvresize)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color='#444444'&gt;LVM's label on the partition. Registers sda3 as LVM storage. pvresize syncs LVM metadata when the partition size changes.&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="200" y="310" width="1000" height="90" as="geometry" />
        </mxCell>

        <!-- Arrow 3 -->
        <mxCell id="41" value=""
          style="endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="400" as="sourcePoint" />
            <mxPoint x="700" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- LAYER 4: VOLUME GROUP -->
        <mxCell id="50"
          value="&lt;b style='font-size:14px'&gt;Volume Group (VG)&lt;/b&gt;&lt;br&gt;&lt;i&gt;ubuntu-vg — 41.65 GB&lt;/i&gt;&lt;br&gt;&lt;font color='#444444'&gt;A storage pool assembled from one or more PVs. Could span multiple physical drives. Here it wraps sda3 only.&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="275" y="430" width="850" height="90" as="geometry" />
        </mxCell>

        <!-- Arrow 4 -->
        <mxCell id="51" value=""
          style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=2;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="520" as="sourcePoint" />
            <mxPoint x="700" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- LAYER 5: LOGICAL VOLUME -->
        <mxCell id="60"
          value="&lt;b style='font-size:14px'&gt;Logical Volume (LV)&lt;/b&gt;&lt;br&gt;&lt;i&gt;ubuntu-lv — 40 GB &lt;font color='#cc0000'&gt;(shrunk from 116 GB with lvreduce)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color='#444444'&gt;A virtual block device carved from the VG. Flexible and resizable without touching partitions. The filesystem lives on this.&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="550" width="700" height="90" as="geometry" />
        </mxCell>

        <!-- Arrow 5 -->
        <mxCell id="61" value=""
          style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="640" as="sourcePoint" />
            <mxPoint x="700" y="670" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- LAYER 6: FILESYSTEM -->
        <mxCell id="70"
          value="&lt;b style='font-size:14px'&gt;ext4 Filesystem&lt;/b&gt;&lt;br&gt;&lt;i&gt;40 GB &lt;font color='#cc0000'&gt;(shrunk first with resize2fs — before touching LV)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color='#444444'&gt;Directories, files, inodes, blocks. Holds your actual Ubuntu installation. Must always be shrunk before the LV above it.&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="425" y="670" width="550" height="90" as="geometry" />
        </mxCell>

        <!-- Arrow 6 -->
        <mxCell id="71" value=""
          style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="760" as="sourcePoint" />
            <mxPoint x="700" y="790" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- LAYER 7: MOUNT POINT -->
        <mxCell id="80"
          value="&lt;b style='font-size:14px'&gt;Mount Point: /&lt;/b&gt;&lt;br&gt;&lt;i&gt;Ubuntu root filesystem&lt;/i&gt;&lt;br&gt;&lt;font color='#444444'&gt;Where the OS accesses everything. All your Ubuntu files, Chromium, kiosk config, and user data are visible from here.&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#67ab9f;fontSize=12;verticalAlign=middle;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="500" y="790" width="400" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
